[
 {
  "id": "m04-l02-v-kotlin-sequence-order-001",
  "params": {
   "nums": "3, 8, 5, 6, 9, 4",
   "n": 1,
   "via": "",
   "citation": "kotlin-docs-sequences#iterable",
   "why": "A list runs `filter` for every element before `map` starts, so `map` runs only for the even numbers that are left. `take` then cuts the finished list, so it cannot remove any `filter` or `map` call from the log."
  },
