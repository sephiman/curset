# Build-context excludes for the backend image (context = repo root).
.git
.github
.idea
**/__pycache__
**/*.pyc
backend/.venv
backend/.pytest_cache
backend/.ruff_cache
backend/.mypy_cache
frontend/node_modules
frontend/dist
*.log
# No runtime reader: served source folders are only normativa and otros (citations/sources.py SERVED_FOLDERS).
content/*/sources/examenes-oficiales
content/*/sources/convocatorias
content/backend-in-depth/sources/docs
content/backend-in-depth/sources/evidence
